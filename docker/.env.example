# --------------------------------------------------------------------------
# tpot-payload-server — Environment Configuration
#
# Copy this file to .env (in this same docker/ directory, next to
# docker-compose.yml) and fill in the values for your deployment.
# --------------------------------------------------------------------------

# OPTIONAL: API key for authenticating requests.
# When empty, authentication is disabled (relies on network-level firewall).
API_KEY=

# REQUIRED (for Docker): Absolute path to T-Pot's data directory on the host.
# This is typically ~/tpotce/data or ./data in the T-Pot installation.
TPOT_DATA_PATH=./data

# OPTIONAL: Port to expose the API on the host (for Docker).
# Note: Ports 1-64000 are forwarded to honeypots and the 64294-64305 range is
# used by T-Pot management services. Pick a port with enough headroom above that.
# Default: 64444
API_PORT=64444

# OPTIONAL: Base directory where honeypot volumes are mounted inside the app.
# Default: /data (used by docker-compose)
BASE_DATA_DIR=/data

# OPTIONAL: Comma-separated list of honeypot subdirectories to scan.
# Default: dionaea/binaries,cowrie/downloads,honeytrap/downloads,adbhoney/downloads
HONEYPOT_DIRS=dionaea/binaries,cowrie/downloads,honeytrap/downloads,adbhoney/downloads
